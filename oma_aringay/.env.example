# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# ── Email (SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password, not your account password. Never commit the
# real .env. (Generate one at https://myaccount.google.com/apppasswords —
# requires 2-Step Verification to be enabled on the Google account.)
#
# If EMAIL_HOST_USER / EMAIL_HOST_PASSWORD are left blank, the system
# automatically falls back to printing emails to the console instead of
# crashing — see settings.py's "hybrid fallback" comment. User creation
# still works either way; only email delivery changes.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Frontend base URL (used to build verification links in emails) ────────
# Leave BLANK for a LAN deployment where the frontend is served from the
# same origin as this API — the verification link will then be derived
# from the incoming request's own host (e.g. http://192.168.1.50), which is
# what actually resolves for office machines on the LAN. There is no public
# domain to hardcode here.
#
# Set this explicitly only when the frontend runs on a different host/port
# than the API, e.g. local dev with Vite:
# FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_BASE_URL=

# How long an email-verification link stays valid, in hours.
EMAIL_VERIFICATION_TOKEN_HOURS=72
