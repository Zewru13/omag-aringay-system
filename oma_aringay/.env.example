# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# ── Secret key ──────────────────────────────────────────────────────────
# Required — the app will not start without it (see settings.py). Signs
# sessions, CSRF tokens, and password-reset tokens, so it must be a real
# random value, never hand-typed. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ── Database backend ────────────────────────────────────────────────────
# mysql    -> real local MySQL/MariaDB (oma_aringay_db) — the working
#             local-dev fallback if Postgres/Supabase isn't configured.
# postgres -> real Supabase Postgres (settings.py's own default) — requires
#             every SUPABASE_DB_* value below to be set, or the app raises
#             on startup.
DB_BACKEND=mysql

# Only required when DB_BACKEND=postgres.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ── Seed data command passwords ─────────────────────────────────────────
# Used by `manage.py seed_data` for the demo Admin/Evaluator accounts it
# creates. Required if DEBUG=False; under DEBUG=True (the local-dev
# default) these may be left blank and the command falls back to a
# well-known local-only demo password — see accounts/management/commands/
# seed_data.py's _seed_password().
SEED_ADMIN_PASSWORD=
SEED_EVAL_PASSWORD=

# ── Email (SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password, not your account password. Never commit the
# real .env. (Generate one at https://myaccount.google.com/apppasswords —
# requires 2-Step Verification to be enabled on the Google account.)
#
# If EMAIL_HOST_USER / EMAIL_HOST_PASSWORD are left blank, the system
# automatically falls back to printing emails to the console instead of
# crashing — see settings.py's "hybrid fallback" comment. User creation
# still works either way; only email delivery changes.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Frontend base URL (used to build verification links in emails) ────────
# Leave BLANK for a LAN deployment where the frontend is served from the
# same origin as this API — the verification link will then be derived
# from the incoming request's own host (e.g. http://192.168.1.50), which is
# what actually resolves for office machines on the LAN. There is no public
# domain to hardcode here.
#
# Set this explicitly only when the frontend runs on a different host/port
# than the API, e.g. local dev with Vite:
# FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_BASE_URL=

# How long an email-verification link stays valid, in hours.
EMAIL_VERIFICATION_TOKEN_HOURS=72
